# Strava API credentials — TEMPLATE (versioned, dummy values)
#
# Usage:
#   cp .env.example .env      then fill .env by hand (never versioned)
#
# Where to get them: https://www.strava.com/settings/api
# The refresh token is obtained once, through the OAuth flow (see scripts/README.md).

# Public: appears in authorization URLs, not sensitive.
STRAVA_CLIENT_ID=00000

# SENSITIVE: equivalent to an application password. Never copy it elsewhere.
STRAVA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SENSITIVE: grants read access to your entire private history, with no expiry.
STRAVA_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

STRAVA_ENDPOINT=https://www.strava.com/api/v3

# --------------------------------------------------------------------------- #
# Outgoing webhook — notify an external service on every new session
# --------------------------------------------------------------------------- #
# Optional. Leaving it empty disables the mechanism entirely.
# Called by strava_publish.py AFTER each new activity has been logged, once per
# activity, as a JSON POST. A failure never blocks the import: it is logged and
# retried on the next pass.
#
# For the AgentsRoom coach trigger, this is the URL the trigger editor mints.
WEBHOOK_URL=

# SENSITIVE: HMAC secret shared with the service being called. The script signs
# the exact body with SHA-256 and sends "X-AgentsRoom-Signature: sha256=<hex>".
# Without it, calls go out UNSIGNED — and the AgentsRoom endpoint rejects those
# with {"error":"REJECTED","message":"Signature missing."}
WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Extra HTTP headers, as JSON on ONE line. Optional: the signature and the
# delivery header are added automatically.
# Example: WEBHOOK_HEADERS={"Authorization":"Bearer xxxxx"}
WEBHOOK_HEADERS=
